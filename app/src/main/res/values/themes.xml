<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Window themes only; the popup is drawn with Compose Material 3 (ui/theme/Theme.kt). -->
    <style name="Theme.QuickSettings" parent="android:Theme.DeviceDefault.Light.NoActionBar" />

    <!-- A floating window that dims what is behind it and closes when tapped outside,
         like a system dialog. The rounded card is drawn by Compose, so the window is clear. -->
    <style name="Theme.QuickSettings.Panel" parent="android:Theme.Material.Light.Dialog.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowMinWidthMajor">100%</item>
        <item name="android:windowMinWidthMinor">100%</item>
        <item name="android:backgroundDimAmount">0.4</item>
        <item name="android:windowCloseOnTouchOutside">true</item>
        <!-- Only the dim fades; the card itself grows in with Compose (ExpandIn.kt). -->
        <item name="android:windowAnimationStyle">@style/Animation.QuickSettings.Panel</item>
    </style>

    <style name="Animation.QuickSettings.Panel" parent="">
        <item name="android:windowEnterAnimation">@android:anim/fade_in</item>
        <item name="android:windowExitAnimation">@android:anim/fade_out</item>
    </style>
</resources>
