<?xml version="1.0" encoding="utf-8"?>
<!-- Long-press shortcuts on the app icon (also usable with Quick Tap): the popups, all but
     Developer, in the order of settings/Shortcuts.kt (#24). Ids and actions keep their old names, so
     shortcuts already on a home screen or set as Quick Tap keep working (they now open the popup).
     Keep in sync with src/debug/res/xml/shortcuts.xml. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_screen"
        android:shortcutId="toggle_private_dns"
        android:shortcutLongLabel="@string/tile_screen_label"
        android:shortcutShortLabel="@string/tile_screen_label">
        <intent
            android:action="to.wim.quicksettings.action.TOGGLE_PRIVATE_DNS"
            android:targetClass="to.wim.quicksettings.shortcut.ShortcutActivity"
            android:targetPackage="to.wim.quicksettings" />
    </shortcut>
    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_colour"
        android:shortcutId="toggle_timeout"
        android:shortcutLongLabel="@string/group_colour"
        android:shortcutShortLabel="@string/group_colour">
        <intent
            android:action="to.wim.quicksettings.action.TOGGLE_TIMEOUT"
            android:targetClass="to.wim.quicksettings.shortcut.ShortcutActivity"
            android:targetPackage="to.wim.quicksettings" />
    </shortcut>
    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_sound"
        android:shortcutId="toggle_always_on"
        android:shortcutLongLabel="@string/group_sound"
        android:shortcutShortLabel="@string/group_sound">
        <intent
            android:action="to.wim.quicksettings.action.TOGGLE_ALWAYS_ON"
            android:targetClass="to.wim.quicksettings.shortcut.ShortcutActivity"
            android:targetPackage="to.wim.quicksettings" />
    </shortcut>
    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_network"
        android:shortcutId="toggle_tap_to_wake"
        android:shortcutLongLabel="@string/group_network"
        android:shortcutShortLabel="@string/group_network">
        <intent
            android:action="to.wim.quicksettings.action.TOGGLE_TAP_TO_WAKE"
            android:targetClass="to.wim.quicksettings.shortcut.ShortcutActivity"
            android:targetPackage="to.wim.quicksettings" />
    </shortcut>
</shortcuts>
