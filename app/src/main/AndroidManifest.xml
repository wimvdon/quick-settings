<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- "Modify system settings" (special access, granted in Settings): brightness and screen timeout. -->
    <uses-permission
        android:name="android.permission.WRITE_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <!-- Always-on display and tap to wake (secure settings) and Private DNS (global settings). Only adb can grant this:
         adb shell pm grant to.wim.quicksettings android.permission.WRITE_SECURE_SETTINGS -->
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <!-- Android 13+: the persistent notifications (manual brightness, long timeout, Private DNS on Automatic). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".QuickSettingsApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.QuickSettings">

        <!-- Main screen: how to add the tiles and grant permissions. -->
        <activity
            android:name=".ui.main.MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Invisible target of the launcher shortcuts. Not exported: shortcuts are started with
             this app's identity, so no other app can invoke it. -->
        <activity
            android:name=".shortcut.ShortcutActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay" />

        <!-- The Screen popup, opened from its tile and notifications. -->
        <activity
            android:name=".ui.panel.PanelActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:theme="@style/Theme.QuickSettings.Panel" />

        <!-- Long-pressing a tile: opens the matching Android settings page, shows nothing itself. -->
        <activity
            android:name=".tile.TilePreferencesActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE_PREFERENCES" />
            </intent-filter>
        </activity>

        <!-- Buttons on the notifications. Private: only our PendingIntents. -->
        <receiver
            android:name=".notify.ResetReceiver"
            android:exported="false" />

        <service
            android:name=".tile.ScreenTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_display"
            android:label="@string/tile_screen_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".tile.DnsTileService"
            android:exported="true"
            android:icon="@drawable/ic_dns"
            android:label="@string/tile_dns_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
        </service>
    </application>

</manifest>
