<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- "Modify system settings" (special access, granted in Settings): brightness, timeout, rotation, touch vibration. -->
    <uses-permission
        android:name="android.permission.WRITE_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <!-- Secure and global settings (always-on display, colours, developer options, Private DNS, …). Only adb can grant this:
         adb shell pm grant to.wim.quicksettings android.permission.WRITE_SECURE_SETTINGS -->
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <!-- Android 13+: the notifications that show while a popup's settings differ from their defaults. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".QuickSettingsApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.QuickSettings">

        <!-- Main screen: every tile and popup to add, permissions and instructions. -->
        <activity
            android:name=".ui.main.MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- Invisible target of the launcher shortcuts. Not exported: shortcuts are started with
             this app's identity, so no other app can invoke it. -->
        <activity
            android:name=".shortcut.ShortcutActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay" />

        <!-- The popups (one activity for all), opened from their tiles, notifications and the main screen. -->
        <activity
            android:name=".ui.panel.PanelActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:theme="@style/Theme.QuickSettings.Panel" />

        <!-- Long-pressing a tile: opens the matching Android settings page, shows nothing itself. -->
        <activity
            android:name=".tile.TilePreferencesActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE_PREFERENCES" />
            </intent-filter>
        </activity>

        <!-- Invisible: shows Android's keyboard picker or volume panel for their tiles. -->
        <activity
            android:name=".action.ActionActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- Buttons on the notifications. Private: only our PendingIntents. -->
        <receiver
            android:name=".notify.ResetReceiver"
            android:exported="false" />

        <!-- The tiles (tile/TileServices.kt). The class names are how Android remembers a tile
             in Quick Settings: never rename them. Popups first, then single tiles. -->
        <service
            android:name=".tile.ScreenTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_display"
            android:label="@string/tile_screen_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".tile.ColourTileService"
            android:exported="true"
            android:icon="@drawable/ic_palette"
            android:label="@string/group_colour"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".tile.SoundTileService"
            android:exported="true"
            android:icon="@drawable/ic_sound"
            android:label="@string/group_sound"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".tile.DeveloperTileService"
            android:exported="true"
            android:icon="@drawable/ic_code"
            android:label="@string/group_developer"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
